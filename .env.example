# Every key is optional. Sources without a key are reported as "not
# configured" and contribute no evidence (nothing is estimated in their place).
# GDELT, Wikimedia, World Bank, PeeringDB, data.europa.eu and CKAN need no key.

# Brand narratives — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Sustainability
# https://openweathermap.org/api (Air Pollution API, free)
OPENWEATHER_API_KEY=
# https://explore.openaq.org/register (free)
OPENAQ_API_KEY=
# https://aqicn.org/data-platform/token/ (free)
AQICN_TOKEN=

# Digital infrastructure
# https://developer.tomtom.com/ (free tier)
TOMTOM_API_KEY=
# https://opencellid.org/ (free)
OPENCELLID_API_KEY=

# Smart tourism
# https://aviationstack.com/ (free tier, HTTP only)
AVIATIONSTACK_API_KEY=
# https://opensky-network.org/ -> Account -> API client (free)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Google Cloud console, Places API (New) — monthly free credit
GOOGLE_PLACES_API_KEY=

# Smart communication
# https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Stakeholders
# https://developer.adzuna.com/ (free)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
