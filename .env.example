# OpenWeatherMap API key (Air Pollution API — free tier) — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_key_here

# TomTom Traffic API key (free tier) — https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_key_here

# Anthropic Claude API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# AviationStack API key (free tier) — https://aviationstack.com/
# Optional: powers flight_arrivals.py. If unset, that component reports
# itself as unavailable instead of failing the pipeline.
AVIATIONSTACK_API_KEY=your_aviationstack_key_here
